FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fieldResiduals;
}

// * * * * * * * * * * * * * * * * * start * * * * * * * * * * * * * * * * * * * //

fieldResiduals
{
    type                    solverInfo;
    libs                    ("libutilityFunctionObjects.so");
    fields                  (p U k epsilon);
    writeResidualFields     yes;
    log                     false;
    writeControl            writeTime;
}

