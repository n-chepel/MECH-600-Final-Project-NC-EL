FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 90;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 90;
    }

    outlet
    {
        type            zeroGradient;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform 90;
    }

    top
    {
        type            slip;
    }

    frontAndBack
    {
        type empty;
    }

    ahmed_body
    {
        type            omegaWallFunction;
        value           uniform 90;
    }
}

